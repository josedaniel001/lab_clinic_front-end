# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ========================================

# Configuración de la aplicación
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Lab Clinic Frontend
NEXT_PUBLIC_APP_URL=https://bioanalisis.com
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_LOG_LEVEL=error

# Configuración de API
NEXT_PUBLIC_API_URL=https://bioanalisisadmin.com/api
API_BASE_URL=https://bioanalisisadmin.com/api

# Configuración de autenticación
NEXTAUTH_URL=https://bioanalisis.com
NEXTAUTH_SECRET=tu-clave-secreta-super-segura-aqui

# Configuración de base de datos (si aplica)
DATABASE_URL=postgresql://usuario:password@servidor:5432/lab_clinic_prod

# Configuración de correo electrónico
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password

# Configuración de servicios externos
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://tu-sentry-dsn

# Configuración de Docker
PORT=3000
HOSTNAME=0.0.0.0

# Configuración específica de producción
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_DEBUG_PANEL=false
NEXT_PUBLIC_API_TIMEOUT=30000

# Configuración de caché
NEXT_PUBLIC_CACHE_ENABLED=true
NEXT_PUBLIC_CACHE_TTL=3600

# Configuración de logs
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false
NEXT_PUBLIC_ENABLE_NETWORK_LOGS=false

# Configuración de seguridad
NEXT_PUBLIC_HTTPS_ONLY=true
NEXT_PUBLIC_SECURE_COOKIES=true

# Configuración de rendimiento
NEXT_PUBLIC_ENABLE_COMPRESSION=true
NEXT_PUBLIC_ENABLE_MINIFICATION=true 