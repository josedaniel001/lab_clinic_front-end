# Configuración de la aplicación
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Lab Clinic Frontend
NEXT_PUBLIC_APP_URL=http://bioanalisis.com

# Configuración de la base de datos (si aplica)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Configuración de API
NEXT_PUBLIC_API_URL=http://bioanalisisadmin.com/api
API_BASE_URL=http://bioanalisisadmin.com/api

# Configuración de autenticación
NEXTAUTH_URL=http://bioanalisis.com
NEXTAUTH_SECRET=your-secret-key-here

# Configuración de correo electrónico
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Configuración de servicios externos
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Configuración de desarrollo
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_LOG_LEVEL=info

# Configuración de Docker
PORT=3000
HOSTNAME=0.0.0.0 