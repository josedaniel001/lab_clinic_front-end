# ========================================
# CONFIGURACIÓN DE DESARROLLO
# ========================================

# Configuración de la aplicación
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Lab Clinic Frontend (Dev)
NEXT_PUBLIC_APP_URL=http://bioanalisis.com
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug

# Configuración de API
NEXT_PUBLIC_API_URL=http://bioanalisisadmin.com/api
API_BASE_URL=http://bioanalisisadmin.com/api

# Configuración de autenticación
NEXTAUTH_URL=http://bioanalisis.com
NEXTAUTH_SECRET=dev-secret-key-change-in-production

# Configuración de base de datos (si aplica)
DATABASE_URL=postgresql://postgres:password@localhost:5432/lab_clinic_dev

# Configuración de correo electrónico
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dev@example.com
SMTP_PASS=dev-password

# Configuración de servicios externos
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Configuración de Docker
PORT=3000
HOSTNAME=0.0.0.0

# Configuración específica de desarrollo
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_DEBUG_PANEL=false
NEXT_PUBLIC_API_TIMEOUT=10000

# Configuración de caché
NEXT_PUBLIC_CACHE_ENABLED=false
NEXT_PUBLIC_CACHE_TTL=300

# Configuración de logs
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=true
NEXT_PUBLIC_ENABLE_NETWORK_LOGS=true 